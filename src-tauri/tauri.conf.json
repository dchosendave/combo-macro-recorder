{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hamin Macro Recorder",
  "version": "1.0.3",
  "identifier": "com.lowie.combo-macro-recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hamin Macro Recorder",
        "width": 660,
        "height": 720,
        "minWidth": 660,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
